@{
    ViewData["Title"] = "إتمام الطلب";
}

<main class="site-shell">
    <partial name="_SiteHeader" />

    <section class="section-block">
        <div class="section-heading">
            <span class="tag">Checkout</span>
            <h2>إتمام الطلب</h2>
            <p class="section-subtitle">راجع طلبك واكتب بيانات التوصيل، والدفع هيتم عند الاستلام.</p>
        </div>

        <div class="checkout-grid">
            <div class="checkout-card">
                <h3>ملخص الطلب</h3>

                <div id="checkout-items" class="checkout-items">
                    <p class="empty-cart">جارٍ تحميل السلة...</p>
                </div>

                <div class="checkout-total">
                    <span>الإجمالي الكلي</span>
                    <strong id="checkout-total">0 EGP</strong>
                </div>

                <a asp-controller="Store" asp-action="Cart" class="checkout-back-link">
                    ← العودة للسلة
                </a>
            </div>

            <form id="checkout-form" class="contact-form checkout-card" novalidate>
                <h3>بيانات التوصيل</h3>

                <label for="checkout-name">الاسم بالكامل</label>
                <input id="checkout-name" name="name" type="text" placeholder="اكتب اسمك" />

                <label for="checkout-phone">رقم الموبايل</label>
                <input id="checkout-phone" name="phone" type="tel" placeholder="01xxxxxxxxx" inputmode="tel" />

                <label for="checkout-address">العنوان</label>
                <textarea
                    id="checkout-address"
                    name="address"
                    rows="4"
                    placeholder="العنوان بالتفصيل"></textarea>

                <div class="payment-method">
                    <span class="payment-method-title">طريقة الدفع</span>
                    <label class="payment-option">
                        <input type="radio" name="payment" value="cod" checked />
                        <span>الدفع عند الاستلام</span>
                    </label>
                </div>

                <button type="submit" class="primary-button" id="checkout-submit">
                    تأكيد الطلب
                </button>

                <p id="checkout-message" class="form-message" aria-live="polite"></p>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/checkout-page.js" asp-append-version="true"></script>
}
